---
/*
 * The home page.
 *
 * Structure follows Myscholar's: a profile block, then a stack of short
 * sections each with a "see all" link. The slot where the theme puts
 * "selected publications" held the handbook; while the handbook is hidden
 * (see HANDBOOK_VISIBLE in src/site.config.ts) the blog takes that slot, so the page
 * still leads with writing rather than opening on a dated timeline.
 *
 * Section sizes come from SITE.home so the page can be tuned without editing
 * this file; setting any count to 0 removes that section.
 */
import { getCollection } from 'astro:content';
import { getPosts } from '../lib/blog';
import { PROFILE, SITE } from '../site.config';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';

const { recentPostCount, updateCount, projectCount } = SITE.home;

const posts = recentPostCount > 0 ? (await getPosts()).slice(0, recentPostCount) : [];

const updates =
  updateCount > 0
    ? (await getCollection('updates'))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, updateCount)
    : [];

const projects =
  projectCount > 0
    ? (await getCollection('projects'))
        .sort((a, b) => {
          if (a.data.selected !== b.data.selected) return a.data.selected ? -1 : 1;
          return b.data.fromDate.valueOf() - a.data.fromDate.valueOf();
        })
        .slice(0, projectCount)
    : [];
---

<Layout prose={false}>
  <section class="profile">
    <div class="profile-text">
      <h1>{PROFILE.name}</h1>
      <p class="role">{PROFILE.role}</p>
      <p class="bio">{PROFILE.bio}</p>
      <p class="profile-links">
        <a href={PROFILE.links.github} rel="me noopener" target="_blank">
          <Icon name="github" size="0.9rem" /> GitHub
        </a>
        <a href="/rss.xml"><Icon name="rss" size="0.9rem" /> RSS</a>
        <span class="location"><Icon name="location" size="0.9rem" /> {PROFILE.location}</span>
      </p>
    </div>
  </section>

  {
    posts.length > 0 && (
      <Section title="Recent posts" moreLink="/blog" moreLabel="All posts">
        <p class="page-lede">
          Field reports — what actually broke, what it cost, and what changed as
          a result.
        </p>
        <div class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </Section>
    )
  }

  {
    projects.length > 0 && (
      <Section title="Projects" moreLink="/projects">
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </Section>
    )
  }

  {
    updates.length > 0 && (
      <Section title="Now" moreLink="/now">
        <ul class="update-list">
          {updates.map((update) => (
            <li>
              <FormattedDate date={update.data.date} format="short" />
              <span>{update.data.summary}</span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Layout>

<style>
  .profile {
    padding-block: var(--space-m) var(--space-s);
  }

  .profile-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    max-inline-size: var(--measure);
  }

  h1 {
    margin: 0;
    font-size: var(--step-4);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    letter-spacing: -0.015em;
  }

  .role {
    margin: 0;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .bio {
    margin: 0;
    color: var(--prose-foreground);
    font-size: var(--step-1);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
  }

  .profile-links a,
  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .profile-links a:hover {
    color: var(--primary);
  }

  .update-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    max-inline-size: var(--measure);
    list-style: none;
  }

  .update-list li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.1rem;
    color: var(--prose-foreground);
  }

  @media (width >= 40rem) {
    .update-list li {
      grid-template-columns: 7rem 1fr;
      gap: var(--space-s);
    }
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
  }

  @media (width >= 52rem) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .post-list {
    display: flex;
    flex-direction: column;
    max-inline-size: var(--measure);
  }

  .post-list > :global(.post-card:last-child) {
    border-block-end: none;
  }
</style>
