---
/*
 * Posts for one tag. Static paths come from the tags actually present in the
 * collection, so an unused tag can never produce an empty page.
 */
import { getPosts, getTagCounts } from '../../../lib/blog';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTagCounts()]);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => (p.data.tags ?? []).includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<Layout
  title={`Posts tagged “${tag}”`}
  description={`Every Debrief post tagged ${tag}.`}
  crumbs={[
    { label: 'Blog', href: '/blog', icon: 'post' },
    { label: 'Tags', href: '/blog/tags' },
    { label: tag },
  ]}
>
  <h1>{tag}</h1>
  <p class="lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>

<style>
  h1 {
    margin: 0;
    font-size: var(--step-4);
    font-weight: var(--font-weight-medium);
  }

  .lede {
    margin-block: var(--space-2xs) var(--space-s);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-list > :global(.post-card:last-child) {
    border-block-end: none;
  }
</style>
