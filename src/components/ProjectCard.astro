---
/*
 * A project on the /projects grid and the home page.
 */
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;
---

<article class="card project-card">
  <a href={`/projects/${project.id}`} class="card-link">
    <div class="card-top">
      <h3>{d.title}</h3>
      <span class="status" data-status={d.status}>{d.status}</span>
    </div>
    <p class="card-dates">
      <FormattedDate date={d.fromDate} format="short" />
      <span aria-hidden="true">→</span>
      {d.toDate ? <FormattedDate date={d.toDate} format="short" /> : <span>now</span>}
    </p>
    <p class="card-description">{d.description}</p>
  </a>

  {
    d.stack.length > 0 && (
      <ul class="card-facets" aria-label="Stack">
        {d.stack.slice(0, 5).map((s: string) => (
          <li><Chip>{s}</Chip></li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);
  }

  .project-card:hover {
    border-color: var(--interactive-border);
    background: color-mix(in oklab, var(--muted) 40%, transparent);
  }

  .card-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  h3 {
    margin: 0;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    text-wrap: balance;
  }

  .card-link:hover h3 {
    color: var(--primary);
  }

  .status {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .status[data-status='active'] { color: var(--stage-mid); }
  .status[data-status='shipped'] { color: var(--stage-done); }
  .status[data-status='paused'],
  .status[data-status='archived'] { color: var(--muted-foreground); }

  .card-dates {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .card-description {
    margin: 0;
    color: var(--prose-foreground);
    font-size: var(--step--1);
    text-wrap: pretty;
  }

  .card-facets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
