---
/*
 * Site footer. Also rendered inside Starlight (see
 * src/components/starlight/Footer.astro) so both halves close the same way.
 *
 * The theme credit is not decoration: the design system in src/styles is
 * derived from My Scholar, which is Apache-2.0 and requires attribution. See
 * NOTICE at the repo root.
 */
import { FOOTER, PROFILE, SITE } from '../site.config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-links">
    <a href={PROFILE.links.github} rel="me noopener" target="_blank">
      <Icon name="github" />
      <span>GitHub</span>
    </a>
    <a href="/rss.xml">
      <Icon name="rss" />
      <span>RSS</span>
    </a>
    <span class="footer-location">
      <Icon name="location" />
      <span>{PROFILE.location}</span>
    </span>
  </div>

  {/*
    Explicit {' '} between elements throughout: Astro collapses the newlines
    that would otherwise separate an inline element from the text after it,
    which silently produced "Content licensedCC BY 4.0." here.
  */}
  <p>
    &copy; {year} {SITE.author}. Content licensed{' '}
    <a href={FOOTER.license.href} rel="license noopener" target="_blank">
      {FOOTER.license.label}
    </a>.
  </p>

  <p class="footer-small">
    Built with{' '}
    <a href="https://astro.build" rel="noopener" target="_blank">Astro</a>{' '}
    and{' '}
    <a href="https://starlight.astro.build" rel="noopener" target="_blank">Starlight</a>.{' '}
    Design adapted from{' '}
    <a href={FOOTER.themeCredit.href} rel="noopener" target="_blank">
      {FOOTER.themeCredit.label}
    </a>{' '}
    (Apache-2.0).{' '}
    <a href={FOOTER.sourceCode} rel="noopener" target="_blank">Source</a>.
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block: var(--space-l) var(--space-m);
    margin-block-start: var(--space-xl);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-block-end: var(--space-2xs);
  }

  .footer-links a,
  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .site-footer p {
    margin: 0;
    text-wrap: pretty;
  }

  .site-footer a {
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }

  .site-footer p a:hover {
    color: var(--primary);
    text-decoration-color: currentColor;
  }

  .footer-small {
    font-size: 0.75rem;
    opacity: 0.85;
  }
</style>
