---
/*
 * Breadcrumb strip, matching the one Myscholar puts under its menu bar.
 * The last crumb is the current page and is not a link.
 */
import Icon from './Icon.astro';
import type { Crumb } from '../types';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/"><Icon name="home" size="0.9rem" /><span class="sr-only">Home</span></a>
    </li>
    {
      items.map((item, i) => (
        <li>
          <span class="sep" aria-hidden="true">/</span>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>
              {item.icon && <Icon name={item.icon} size="0.9rem" />}
              <span>{item.label}</span>
            </a>
          ) : (
            <span class="current" aria-current="page">
              {item.icon && <Icon name={item.icon} size="0.9rem" />}
              <span>{item.label}</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--border);
    font-size: var(--step--1);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-inline-size: 0;
  }

  a,
  .current {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  a:hover {
    color: var(--primary);
  }

  .current {
    color: var(--foreground);
    /* Long post titles shouldn't push the strip onto three lines. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-inline-size: min(28rem, 60vw);
  }

  .sep {
    color: var(--border);
  }
</style>
