---
/*
 * A small local icon set, inlined as SVG.
 *
 * Myscholar pulls two Iconify packages plus @iconify/utils for this. The site
 * needs eleven glyphs, so a hand-kept map avoids three dependencies and a
 * build-time icon pipeline. Paths are from Mingcute (Apache-2.0), the same
 * set Myscholar uses, so the stroke weight matches the rest of the design.
 *
 * Icons are stroke-based at 1.5px on a 24-grid and inherit currentColor.
 */
import type { IconName } from '../types';

/**
 * Extra attributes are spread onto the <svg>. Without this, anything not
 * named below is silently dropped — which is how `data-theme-icon` went
 * missing from ThemeToggle's three glyphs and left the theme control
 * rendering as an empty button on every custom page. Silent prop-dropping is
 * worth designing out rather than remembering.
 */
interface Props extends astroHTML.JSX.SVGAttributes {
  name: IconName;
  size?: string;
  class?: string;
}

const ICONS = {
  github:
    'M8.5 20.5c-4 1-4-2.5-5.5-3m11 5v-3.9a3.3 3.3 0 0 0-.9-2.6c2.6-.3 5.4-1.3 5.4-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.4-.4-4.5 1.7a11 11 0 0 0-5.8 0C3.7 3.1 2.3 3.5 2.3 3.5a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 .9 10c0 4.6 2.8 5.6 5.4 6a3.3 3.3 0 0 0-.9 2.6v3.9',
  rss: 'M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19a1 1 0 1 0 .01 0',
  home: 'M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z',
  book: 'M4 5a2 2 0 0 1 2-2h13v18H6a2 2 0 0 1-2-2zm5 0v14',
  post: 'M5 3h14v18H5zM8 8h8M8 12h8M8 16h5',
  tool: 'M14.7 6.3a4 4 0 1 0 5 5L21 21H3l9.7-15.6z',
  sun: 'M12 4V2m0 20v-2m8-8h2M2 12h2m13.7-5.7 1.4-1.4M4.9 19.1l1.4-1.4m11.4 0 1.4 1.4M4.9 4.9l1.4 1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  moon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z',
  monitor: 'M3 5h18v11H3zM9 20h6M12 16v4',
  arrowRight: 'M5 12h14m-6-6 6 6-6 6',
  arrowUp: 'M12 19V5m-6 6 6-6 6 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0',
  link: 'M9 15l6-6M11 6l1-1a4 4 0 0 1 6 6l-1 1m-4 4-1 1a4 4 0 0 1-6-6l1-1',
  location: 'M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11zm0-8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
} as const;

const { name, size = '1rem', class: className, ...rest } = Astro.props;
const path = ICONS[name];
---

<svg
  class={className}
  width={size}
  height={size}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
