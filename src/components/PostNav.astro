---
/*
 * Previous/next post links at the foot of a post. Starlight gives the
 * handbook this for free via `pagination: true`; the blog needs it built,
 * and it's worth having — most of these 2013-2022 posts arrive from search
 * with no other route onward.
 */
import type { Post } from '../lib/blog';
import Icon from './Icon.astro';

interface Props {
  newer: Post | null;
  older: Post | null;
}

const { newer, older } = Astro.props;
---

{
  (newer || older) && (
    <nav class="post-nav" aria-label="More posts">
      {newer ? (
        <a href={`/blog/${newer.id}`} rel="prev" class="nav-card">
          <span class="nav-dir">
            <Icon name="arrowRight" size="0.8rem" class="flip" /> Newer
          </span>
          <span class="nav-title">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {older && (
        <a href={`/blog/${older.id}`} rel="next" class="nav-card align-end">
          <span class="nav-dir">
            Older <Icon name="arrowRight" size="0.8rem" />
          </span>
          <span class="nav-title">{older.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    margin-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  @media (width >= 40rem) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);
  }

  .nav-card:hover {
    border-color: var(--interactive-border);
    background: var(--interactive-background);
  }

  .align-end {
    text-align: end;
    align-items: flex-end;
  }

  .nav-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav-title {
    color: var(--foreground);
    font-size: var(--step-0);
    line-height: var(--line-height-tight);
    text-wrap: balance;
  }

  .flip {
    transform: rotate(180deg);
  }
</style>
