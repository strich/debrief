---
/*
 * A post in a listing (home page, /blog index, tag pages).
 *
 * Shows title, date, reading time, description and tags. The whole card is
 * one link target rather than just the title — a bigger hit area on touch —
 * with the tag chips lifted out of the anchor so they stay independently
 * clickable.
 */
import type { Post } from '../lib/blog';
import { readingTime } from '../lib/blog';
import Chip from './Chip.astro';
import FormattedDate from './FormattedDate.astro';
import StageBadge from './StageBadge.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const minutes = readingTime(post.body);
const tags = post.data.tags ?? [];
---

<article class="post-card">
  <a href={`/blog/${post.id}`} class="post-link">
    <h3>{post.data.title}</h3>
    <p class="post-meta">
      <FormattedDate date={post.data.pubDate} />
      <span class="dot" aria-hidden="true">·</span>
      <span class="reading-time">{minutes} min read</span>
      {post.data.stage && <StageBadge value={post.data.stage} />}
    </p>
    {post.data.description && <p class="post-description">{post.data.description}</p>}
  </a>

  {
    tags.length > 0 && (
      <ul class="post-tags" aria-label="Tags">
        {tags.map((tag: string) => (
          <li>
            <Chip href={`/blog/tags/${tag}`}>{tag}</Chip>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block: var(--space-s);
    border-block-end: 1px solid var(--border);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
  }

  h3 {
    margin: 0;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    text-wrap: balance;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .post-link:hover h3 {
    color: var(--primary);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--muted-foreground);
  }

  .reading-time {
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .dot {
    color: var(--border);
  }

  .post-description {
    margin: 0;
    color: var(--prose-foreground);
    font-size: var(--step-0);
    text-wrap: pretty;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
