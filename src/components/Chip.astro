---
/*
 * Small pill for tags and skills. A link when `href` is given, inert text
 * otherwise, so the same component serves a clickable tag on a post and a
 * non-clickable skill on a project card.
 */
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['chip', className]} href={href}><slot /></Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);
  }

  a.chip:hover {
    border-color: var(--interactive-border);
    background-color: var(--interactive-background);
    color: var(--foreground);
  }
</style>
